/* ==========================================================
   El Híbrido Ganador - Estilos personalizados
   Estos estilos complementan a Bootstrap 5 (cargado por CDN)
   ========================================================== */

body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background-color: #f4f6f9;
    color: #212529;
}

header {
    background-color: #0f4c81;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.hero {
    background: linear-gradient(135deg, #0f4c81, #1d2d44);
    color: white;
    padding: 50px 20px;
    border-radius: 15px;
}

.card-servicio {
    border: none;
    border-radius: 12px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
}

.card-servicio:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 15px rgba(15, 48, 81, 0.12);
}

.video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 12px;
}

.video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

aside {
    background: #fff;
    border-left: 4px solid #0f4c81;
    border-radius: 6px;
}

footer {
    background-color: #212529;
    color: #a8aeb4;
}

/* Tarjetas de solicitudes registradas dinámicamente */
#contenedorLista .card {
    transition: all 0.2s ease;
}

@media (max-width: 768px) {
    .hero {
        padding: 30px 15px;
    }
    aside {
        border-left: none;
        border-top: 4px solid #0f4c81;
    }
}